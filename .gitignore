results/tables/*
!results/tables/.gitkeep
results/logs/*
!results/logs/.gitkeep

# Large data files generated during analysis
analysis/notebooks/*.html
analysis/notebooks/*.nb.html

# Python/Conda caches
__pycache__/
.ipynb_checkpoints/
.conda/

# IDE files
.vscode/
.idea/
